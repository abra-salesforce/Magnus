<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Close_Event_Checkbox</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
Close_Event__c = False, 
Text(Event_Status__c )= &quot;Closed&quot; 
)</errorConditionFormula>
    <errorDisplayField>Close_Event__c</errorDisplayField>
    <errorMessage>Should we close the event?</errorMessage>
</ValidationRule>
