    var voicenterCdrCounter = {
        total: 0,
        current: 0
    };

    function voicenterResponse(cdrList) {
        document.getElementById("voicenterCdrCounter").style.display='block';
        document.getElementById("voicenterCdrCounterTotal").innerText = cdrList.CDR_LIST.length;
        document.getElementById("voicenterCdrCounterCurrent").innerText = '0';
        voicenterCdrCounter.total = cdrList.CDR_LIST.length;
        voicenterCdrCounter.current = 0;
        console.log(voicenterCdrCounter);
        console.log(cdrList);
        var index;
        for(index = 0; index < cdrList.CDR_LIST.length; index++){
            console.log(cdrList.CDR_LIST[index]);
            Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.VoicenterApex.LogCalls}',
                                                      cdrList.CRM_DATA,
                                                      cdrList.CDR_LIST[index],        
                                                      function(result, event){
                                                          
                                                          console.log(result); 
                                                          if(result.Error == ""){
                                                              // Report success:
                                                              var url = "https://api1.voicenter.co.il/hub/SalesforceCDR/Update?code=nImy5qteTuZISJuJcfvf&responseType=jsonp";
                                                              url += '&jsonpFunction=voicenterReportResponse';
                                                              url += '&urlID=' + result.CDR.UrlID;
                                                              url += '&cdrID=' + result.CDR.ID;
                                                              url += '&salesforceID=' + result.InsertResult[0].Id;
                                                              url += '&faultReason=OK'
                                                              
                                                              var script = document.createElement('script');     
                                                              script.src = url;
                                                              document.body.appendChild(script);
                                                              voicenterCdrCounter.current++;
                                                              document.getElementById("voicenterCdrCounterCurrent").innerText = voicenterCdrCounter.current;
                                                              if(voicenterCdrCounter.current == voicenterCdrCounter.total){
                                                                  voicenterCdrCounter.current = 0;
                                                                  voicenterCdrCounter.total = 0;
                                                                  document.getElementById("voicenterCdrCounter").style.display='none';
                                                                  setTimeout(RemoteLogCall, 3000);
                                                              }
                                                          }
                                                      }, 
                                                      {escape: true}
                                                     );
        }
    }

