    function RemoteFindIDByPhone(phone) {
        var objectPhone = "";
        if(typeof phone == "undefined")
            objectPhone = document.getElementById('ObjectPhone').value;
        else
            objectPhone = phone;
        Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.VoicenterApex.FindObjectByPhone}',
            objectPhone, 
            function(result, event){
                console.log(result);
                parseFindIDByPhone(result);
            }, 
            {escape: true}
        );        
    }
    
